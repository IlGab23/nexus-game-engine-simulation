{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DefaultAdmin": {
    "Email": "admin@nexus.prod",
    "Username": "Admin"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.nexusgameengine.com",
      "https://admin.nexusgameengine.com"
    ]
  },
  "RateLimiting": {
    "LoggedUser": {
      "PermitLimit": 90,
      "TimeLimitInSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "IpUser": {
      "PermitLimit": 18,
      "TimeLimitInSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}