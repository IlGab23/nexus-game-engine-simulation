{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "CONNECTION_STRING_IN_USER_SECRET"
  },
  "Jwt": {
    "SecretKey": "SECRETKEY_STRING_IN_USER_SECRET",
    "ExpireInMinutes": 10,
    "Issuer": "NexusGameEngine.API",
    "Audience": "NexusGameEngine.Client"
  },
  "RT": {
    "ExpiryInDays": 7
  },
  "DefaultAdmin": {
    "Email": "admin@nexusdev.local",
    "Username": "AdminDev"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "LoggedUser": {
      "PermitLimit": 90,
      "TimeLimitInSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "IpUser": {
      "PermitLimit": 18,
      "TimeLimitInSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}